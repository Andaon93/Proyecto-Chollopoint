# ============================================================
#  .htaccess — CholloPoint Backend
#  Redirige todas las peticiones a index.php
# ============================================================

Options -Indexes

RewriteEngine On

# Ignorar archivos y directorios que existen realmente
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Todo lo demás va a index.php
RewriteRule ^ index.php [QSA,L]

# Seguridad: ocultar archivos sensibles
<FilesMatch "\.(sql|md|env|log)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>
